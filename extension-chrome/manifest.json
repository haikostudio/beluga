{
  "manifest_version": 3,
  "name": "__MSG_nom__",
  "description": "__MSG_description__",
  "version": "1.0.12",
  "default_locale": "fr",
  "minimum_chrome_version": "116",
  "icons": { "16": "icones/icone-16.png", "32": "icones/icone-32.png", "48": "icones/icone-48.png", "128": "icones/icone-128.png" },
  "action": { "default_title": "Beluga", "default_icon": { "16": "icones/icone-16.png", "32": "icones/icone-32.png" } },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "permissions": ["debugger", "tabs", "tabGroups", "sidePanel", "scripting", "storage", "alarms", "contextMenus"],
  "host_permissions": ["<all_urls>"]
}
